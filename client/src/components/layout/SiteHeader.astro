---
import { CaretDownIcon, MagnifyingGlassIcon, UserCircleIcon } from "@phosphor-icons/react";
import { CartIndicator } from "@/components/cart/CartIndicator";
import { CART_COUNT_COOKIE } from "@/stores/cart";
import { MobileNavigation } from "./MobileNavigation";

const cookieCount = Number.parseInt(Astro.cookies.get(CART_COUNT_COOKIE)?.value ?? "0", 10);
const initialCartCount = Number.isFinite(cookieCount) ? Math.max(0, cookieCount) : 0;
---

<header class="site-header">
  <div class="site-header__main shell">
    <a class="brand" href="/" aria-label="Silk home">
      <span>Silk</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      <a href="/shop">Shop <CaretDownIcon aria-hidden="true" size={12} weight="bold" /></a>
      <a href="/shop?availability=in-stock">On sale</a>
      <a href="/#new-arrivals">New arrivals</a>
      <a href="/shop">Brands</a>
    </nav>

    <form action="/shop" class="site-header__search" method="get" role="search">
      <MagnifyingGlassIcon aria-hidden="true" size={18} weight="regular" />
      <label class="sr-only" for="catalogue-search">Search the catalogue</label>
      <input
        id="catalogue-search"
        name="search"
        placeholder="Search for products"
        type="search"
      />
    </form>

    <div class="site-header__actions">
      <CartIndicator initialCount={initialCartCount} client:load />
      <a class="account-action" href="/account" aria-label="Your account">
        <UserCircleIcon aria-hidden="true" size={22} weight="bold" />
      </a>
    </div>
    <MobileNavigation client:load />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
  }

  .site-header__main {
    display: grid;
    min-height: 4.8rem;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 820;
    letter-spacing: -0.065em;
  }

  .site-header__nav,
  .site-header__search {
    display: none;
  }

  :global(astro-island:has(.mobile-navigation)) {
    position: relative;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  :global(.cart-indicator) {
    position: relative;
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
  }

  .account-action {
    display: none;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border-radius: 50%;
  }

  :global(.cart-indicator span) {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    display: grid;
    min-width: 1.15rem;
    height: 1.15rem;
    place-items: center;
    padding-inline: 0.2rem;
    border-radius: 999px;
    background: var(--action);
    color: var(--action-text);
    font-size: 0.6rem;
    font-weight: 760;
  }

  :global(.mobile-navigation__trigger) {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
  }

  :global(.mobile-navigation__panel) {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    width: min(21rem, calc(100vw - 2rem));
    padding: 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
    box-shadow: 0 1.5rem 4rem rgb(20 20 16 / 16%);
  }

  :global(.mobile-navigation__panel nav) {
    display: grid;
  }

  :global(.mobile-navigation__panel nav a) {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
    font-weight: 680;
  }

  :global(.mobile-navigation__search) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-control);
    background: var(--surface-muted);
  }

  :global(.mobile-navigation__search input) {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 64rem) {
    .site-header__main {
      grid-template-columns: auto auto minmax(15rem, 1fr) auto;
      gap: clamp(1.1rem, 2.2vw, 2rem);
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: clamp(1rem, 1.7vw, 1.8rem);
      font-size: 0.84rem;
      font-weight: 650;
      white-space: nowrap;
    }

    .site-header__nav a {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: color 150ms ease;
    }

    .site-header__nav a:hover {
      color: var(--text-muted);
    }

    .site-header__search {
      display: flex;
      min-height: 2.85rem;
      align-items: center;
      gap: 0.65rem;
      justify-self: end;
      width: min(100%, 24rem);
      padding: 0.55rem 1rem;
      border-radius: var(--radius-control);
      background: var(--surface-muted);
      color: var(--text-muted);
    }

    .site-header__search input {
      min-width: 0;
      flex: 1;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: 0.82rem;
    }

    :global(astro-island:has(.mobile-navigation)) {
      display: none;
    }

    .account-action {
      display: grid;
    }
  }
</style>
