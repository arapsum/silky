---
import CatalogueMessage from "@/components/catalogue/CatalogueMessage.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import ProductGrid from "@/components/products/ProductGrid.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts } from "@/lib/api/client";
import type { ProductListItem } from "@/lib/api/types";

let curatedProducts: ProductListItem[] = [];

try {
  const response = await getProducts(new URLSearchParams({ limit: "4", page: "1" }));
  curatedProducts = response.data.filter((product) => product.primaryImage).slice(0, 4);
} catch {
  // The landing page still renders its editorial content when the catalogue is unavailable.
}
---

<BaseLayout
  title="Silk | Clothes that feel like you"
  description="Discover Silk: considered clothing, quiet essentials, and a wardrobe designed to move with you."
  image="/images/silk-luxury-hero-editorial.webp"
>
  <SiteHeader />

  <main class="home-page" aria-label="Silk landing page">
    <section class="home-page__hero shell" aria-labelledby="hero-heading">
      <div class="home-page__hero-copy">
        <h1 id="hero-heading" class="display-title">Clothes that feel like you.</h1>
        <p class="home-page__lede">
          Timeless pieces, made to move with you—for every day, in every way.
        </p>
        <div class="home-page__actions">
          <a class="button-primary" href="/shop">Shop the collection</a>
          <a class="button-secondary" href="#curated">See what’s new</a>
        </div>
      </div>

      <picture class="home-page__hero-art home-page__hero-art--light">
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-hero-mobile.avif 900w"
          type="image/avif"
        />
        <source
          srcset="/images/silk-luxury-hero-editorial.avif 860w"
          type="image/avif"
        />
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-hero-mobile.webp 900w"
          type="image/webp"
        />
        <img
          alt="Two models wearing neutral Silk tailoring"
          decoding="async"
          fetchpriority="high"
          height="725"
          loading="eager"
          src="/images/silk-luxury-hero-editorial.webp"
          width="860"
        />
      </picture>
      <picture class="home-page__hero-art home-page__hero-art--dark" aria-hidden="true">
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-hero-mobile-dark-transparent.avif 1402w"
          type="image/avif"
        />
        <source
          srcset="/images/silk-luxury-hero-editorial-dark-transparent.avif 1366w"
          type="image/avif"
        />
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-hero-mobile-dark-transparent.webp 1402w"
          type="image/webp"
        />
        <img
          alt=""
          decoding="async"
          height="1151"
          loading="lazy"
          src="/images/silk-luxury-hero-editorial-dark-transparent.webp"
          width="1367"
        />
      </picture>
    </section>

    <nav class="home-page__category-rail shell" aria-label="Shop by category">
      <a href="/shop">
        <span class="eyebrow">01</span>
        <span>Women</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/shop">
        <span class="eyebrow">02</span>
        <span>Men</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/shop?category=accessories">
        <span class="eyebrow">03</span>
        <span>Bags</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/shop?category=accessories">
        <span class="eyebrow">04</span>
        <span>Accessories</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/shop">
        <span class="eyebrow">05</span>
        <span>The edit</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <section class="home-page__story shell" aria-labelledby="collection-heading">
      <picture class="home-page__story-art home-page__story-art--light">
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-collection-mobile.avif 820w"
          type="image/avif"
        />
        <source
          srcset="/images/silk-luxury-collection-editorial.avif 844w"
          type="image/avif"
        />
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-collection-mobile.webp 820w"
          type="image/webp"
        />
        <img
          alt="A model in a softly tailored Silk suit"
          decoding="async"
          height="422"
          loading="lazy"
          src="/images/silk-luxury-collection-editorial.webp"
          width="844"
        />
      </picture>
      <picture class="home-page__story-art home-page__story-art--dark" aria-hidden="true">
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-collection-mobile-dark-transparent.avif 1087w"
          type="image/avif"
        />
        <source
          srcset="/images/silk-luxury-collection-editorial-dark-transparent.avif 1774w"
          type="image/avif"
        />
        <source
          media="(max-width: 48rem)"
          srcset="/images/silk-luxury-collection-mobile-dark-transparent.webp 1087w"
          type="image/webp"
        />
        <img
          alt=""
          decoding="async"
          height="887"
          loading="lazy"
          src="/images/silk-luxury-collection-editorial-dark-transparent.webp"
          width="1774"
        />
      </picture>

      <div class="home-page__story-copy">
        <p class="eyebrow">The collection</p>
        <h2 id="collection-heading" class="display-title">Build a wardrobe, not a costume.</h2>
        <p>
          Explore considered pieces across shirting, knitwear, outerwear, and accessories.
        </p>
        <a class="text-link" href="/shop">Explore the collection <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="home-page__curated shell" id="curated" aria-labelledby="curated-heading">
      <div class="home-page__section-heading">
        <div>
          <p class="eyebrow">Curated selection</p>
          <h2 id="curated-heading" class="display-title">Pieces that work together, season after season.</h2>
        </div>
        <p>A considered edit of everyday essentials and quiet statements, designed to live with you.</p>
      </div>

      {
        curatedProducts.length > 0 ? (
          <ProductGrid products={curatedProducts} eagerCount={1} />
        ) : (
          <CatalogueMessage
            title="The edit is being prepared"
            message="The collection is almost ready. Visit the shop to browse the latest Silk pieces."
          />
        )
      }
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .home-page {
    overflow: clip;
    background: var(--surface);
    color: var(--text);
  }

  .home-page .shell {
    width: min(calc(100% - clamp(2rem, 5vw, 4rem)), 80rem);
  }

  .home-page__hero {
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
  }

  .home-page__hero-copy {
    max-width: 31rem;
    padding-block: 1rem;
  }

  .home-page__hero-copy h1 {
    max-width: 9ch;
    margin: 0;
    font-size: var(--text-display);
  }

  .home-page__lede {
    max-width: 30ch;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .home-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-page__hero-art,
  .home-page__story-art {
    display: block;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .home-page__hero-art--dark,
  .home-page__story-art--dark {
    display: none;
    background: var(--surface);
  }

  :global(html[data-theme="dark"]) .home-page__hero-art--light,
  :global(html[data-theme="dark"]) .home-page__story-art--light {
    display: none;
  }

  :global(html[data-theme="dark"]) .home-page__hero-art--dark,
  :global(html[data-theme="dark"]) .home-page__story-art--dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .home-page__hero-art--light,
    :global(html:not([data-theme="light"])) .home-page__story-art--light {
      display: none;
    }

    :global(html:not([data-theme="light"])) .home-page__hero-art--dark,
    :global(html:not([data-theme="light"])) .home-page__story-art--dark {
      display: block;
    }
  }

  .home-page__hero-art {
    aspect-ratio: 860 / 725;
    max-height: min(34rem, 56vh);
  }

  .home-page__hero-art img,
  .home-page__story-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-page__category-rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .home-page__category-rail a {
    display: grid;
    min-height: 6.25rem;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto 1fr;
    align-items: end;
    gap: 0.35rem 0.8rem;
    padding: 1rem;
    border-right: 1px solid var(--border);
    transition: background-color 160ms ease;
  }

  .home-page__category-rail a:first-child {
    border-left: 1px solid var(--border);
  }

  .home-page__category-rail a:hover {
    background: var(--surface-muted);
  }

  .home-page__category-rail .eyebrow {
    grid-column: 1 / -1;
    color: var(--text-muted);
  }

  .home-page__category-rail a > span:nth-child(2) {
    font-family: var(--font-display);
    font-size: var(--text-category);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .home-page__story {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 8rem);
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .home-page__story-art {
    aspect-ratio: 844 / 422;
  }

  .home-page__story-copy {
    max-width: 30rem;
  }

  .home-page__story-copy .eyebrow,
  .home-page__section-heading .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--text-muted);
  }

  .home-page__story-copy h2 {
    max-width: 10ch;
    margin: 0;
    font-size: var(--text-headline);
  }

  .home-page__story-copy > p:not(.eyebrow) {
    max-width: 31ch;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.45rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-page__curated {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .home-page__section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    padding-top: clamp(1.25rem, 2vw, 2rem);
    border-top: 1px solid var(--border);
  }

  .home-page__section-heading h2 {
    max-width: 15ch;
    margin: 0;
    font-size: var(--text-headline);
  }

  .home-page__section-heading > p {
    max-width: 29ch;
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  @media (max-width: 63.99rem) {
    .home-page__hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
    }

    .home-page__hero-copy h1 {
      font-size: var(--text-headline);
    }

    .home-page__story {
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  @media (max-width: 48rem) {
    .home-page__hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
      padding-block: clamp(2.75rem, 10vw, 4.5rem) clamp(3rem, 10vw, 5rem);
    }

    .home-page__hero-copy {
      max-width: none;
      padding: 0;
    }

    .home-page__hero-copy h1 {
      max-width: 8ch;
      font-size: var(--text-headline);
    }

    .home-page__hero-art {
      width: 100%;
      max-height: none;
    }

    .home-page__category-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-page__category-rail a {
      min-height: 5.75rem;
      padding: 0.85rem;
    }

    .home-page__category-rail a:nth-child(odd) {
      border-left: 1px solid var(--border);
    }

    .home-page__category-rail a:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }

    .home-page__category-rail a:last-child {
      grid-column: 1 / -1;
    }

    .home-page__story {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
      padding-block: clamp(4rem, 14vw, 6rem);
    }

    .home-page__story-art {
      order: 2;
      aspect-ratio: 820 / 560;
    }

    .home-page__story-copy {
      order: 1;
      max-width: none;
    }

    .home-page__story-copy h2 {
      font-size: var(--text-headline);
    }

    .home-page__section-heading {
      display: block;
      margin-bottom: 2rem;
    }

    .home-page__section-heading h2 {
      max-width: 11ch;
      font-size: var(--text-headline);
    }

    .home-page__section-heading > p {
      max-width: 34ch;
      margin-top: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-page__category-rail a {
      transition: none;
    }
  }
</style>
