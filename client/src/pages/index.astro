---
import { ArrowRightIcon } from "@phosphor-icons/react";
import CatalogueMessage from "@/components/catalogue/CatalogueMessage.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import ProductGrid from "@/components/products/ProductGrid.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getProducts } from "@/lib/api/client";
import type { CategoryListItem, ProductListItem } from "@/lib/api/types";
import { titleCase } from "@/lib/format";

let products: ProductListItem[] = [];
let categories: CategoryListItem[] = [];
let catalogueUnavailable = false;

const [productResult, categoryResult] = await Promise.allSettled([
  getProducts(new URLSearchParams({ limit: "20", page: "1" })),
  getCategories(new URLSearchParams({ limit: "20", page: "1" })),
]);

if (productResult.status === "fulfilled") {
  products = productResult.value.data;
} else {
  catalogueUnavailable = true;
}

if (categoryResult.status === "fulfilled") {
  categories = categoryResult.value.data;
} else {
  catalogueUnavailable = true;
}

const featuredProducts = products.slice(0, 4);
---

<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero__content">
        <p class="hero__meta"><span>Silk</span><span>Wardrobe index</span></p>
        <h1 class="display-title" id="hero-heading">Clothes that feel like you.</h1>
        <p class="hero__copy">
          Quietly confident pieces, selected for how they feel, layer, and live.
          Build a wardrobe that gives you room to be yourself.
        </p>
        <div class="hero__actions">
          <a class="button-primary" href="/shop">
            Shop the collection
            <ArrowRightIcon aria-hidden="true" size={18} weight="bold" />
          </a>
          <a class="hero__secondary-action" href="#new-arrivals">See what’s new</a>
        </div>
      </div>
      <div class="hero__media">
        <img
          alt="Two models wearing Silk's refined everyday collection"
          class="hero__image"
          decoding="sync"
          fetchpriority="high"
          height="810"
          src="/images/silk-editorial-hero.webp"
          width="1439"
        />
        <span class="hero__caption">A considered edit for everyday life</span>
      </div>
    </section>

    {
      categories.length > 0 && (
        <nav class="category-ribbon" aria-label="Shop by category">
          <div class="shell category-ribbon__inner">
            <span class="category-ribbon__label">Start with</span>
            {categories.map((category) => (
              <a href={`/shop?category=${category.slug}`}>
                {titleCase(category.name)}
                <ArrowRightIcon aria-hidden="true" size={15} weight="bold" />
              </a>
            ))}
          </div>
        </nav>
      )
    }

    <section class="collection shell" id="new-arrivals" aria-labelledby="new-arrivals-heading">
      <header class="section-heading">
        <div>
          <h2 class="display-title" id="new-arrivals-heading">New arrivals</h2>
          <p class="section-heading__note">The pieces setting the pace for the current edit.</p>
        </div>
        <a class="section-heading__link" href="/shop">
          View the full edit
          <ArrowRightIcon aria-hidden="true" size={17} weight="bold" />
        </a>
      </header>

      {
        featuredProducts.length > 0 ? (
          <ProductGrid products={featuredProducts} eagerCount={2} />
        ) : (
          <CatalogueMessage
            title={catalogueUnavailable ? "The collection is taking a moment" : "New pieces are on their way"}
            message={catalogueUnavailable
              ? "The catalogue service is unavailable right now. Please refresh in a moment."
              : "There are no products in this edit yet. Check back soon."}
          />
        )
      }
    </section>

    <section class="editorial shell" aria-labelledby="editorial-heading">
      <div class="editorial__image-wrap">
        <img
          alt="A crisp white shirt from the Silk collection"
          class="editorial__image"
          decoding="async"
          height="900"
          loading="lazy"
          src={categories.find((category) => category.slug === "shirts")?.imageLink ?? "https://images.unsplash.com/photo-1603252109303-2751441dd157?auto=format&fit=crop&w=1200&q=85"}
          width="900"
        />
      </div>
      <div class="editorial__content">
        <h2 class="display-title" id="editorial-heading">Build a wardrobe, not a costume.</h2>
        <p>
          Start with shape, texture, and the way a piece earns its place. Our
          edit keeps the palette calm so every new addition has more than one life.
        </p>
        <a class="button-secondary" href="/shop?category=shirts">Explore shirting</a>
      </div>
    </section>

    {
      categories.length > 0 && (
        <section class="categories shell" aria-labelledby="categories-heading">
          <header class="section-heading">
            <div>
              <h2 class="display-title" id="categories-heading">Browse by category</h2>
              <p class="section-heading__note">Find the pieces that make sense for the way you dress.</p>
            </div>
          </header>

          <div class="category-grid">
            {categories.slice(0, 5).map((category, index) => (
              <a class={`category-tile category-tile--${index + 1}`} href={`/shop?category=${category.slug}`}>
                <img
                  alt=""
                  decoding="async"
                  height="760"
                  loading="lazy"
                  src={category.imageLink}
                  width="980"
                />
                <span>
                  <small>{category.productCount} {category.productCount === 1 ? "piece" : "pieces"}</small>
                  <strong>{titleCase(category.name)}</strong>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="closing-cta shell" aria-labelledby="closing-cta-heading">
      <div>
        <h2 class="display-title" id="closing-cta-heading">Make room for what you’ll wear.</h2>
        <p>Pieces selected to layer, wear, and live together.</p>
      </div>
      <a class="button-secondary" href="/shop">
        Shop the full edit
        <ArrowRightIcon aria-hidden="true" size={17} weight="bold" />
      </a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  .hero {
    display: grid;
    min-height: clamp(38rem, 58vw, 50rem);
    margin-top: 1rem;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: #e7d9c1;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    color: #171713;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    color: rgb(23 23 19 / 62%);
    font-size: 0.64rem;
    font-weight: 780;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero__meta span + span {
    padding-left: 0.7rem;
    border-left: 1px solid rgb(23 23 19 / 35%);
  }

  .hero h1 {
    max-width: 8ch;
    margin: auto 0 0;
    font-size: clamp(3.5rem, 7vw, 6.9rem);
  }

  .hero__copy {
    max-width: 28rem;
    margin: 0;
    color: rgb(23 23 19 / 72%);
    font-size: clamp(0.95rem, 1.3vw, 1.08rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .hero__secondary-action,
  .section-heading__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.28rem;
    font-size: 0.78rem;
    font-weight: 750;
  }

  .hero__media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: #d3c1a3;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .hero__caption {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    max-width: 13rem;
    padding: 0.45rem 0.65rem;
    background: rgb(23 23 19 / 76%);
    color: #fffef9;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .category-ribbon {
    margin-top: 0;
    border-block: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .category-ribbon__inner {
    display: flex;
    overflow-x: auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    padding-block: 1.15rem;
    scrollbar-width: none;
  }

  .category-ribbon__inner::-webkit-scrollbar {
    display: none;
  }

  .category-ribbon__label {
    flex: none;
    color: var(--text-muted);
    font-size: 0.66rem;
    font-weight: 780;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .category-ribbon a {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 660;
    letter-spacing: -0.03em;
    transition: color 150ms ease;
  }

  .category-ribbon a:hover {
    color: var(--text-muted);
  }

  .collection,
  .categories {
    padding-top: clamp(5.5rem, 10vw, 9.5rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
  }

  .section-heading__note {
    max-width: 28ch;
    margin: 0.85rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .editorial {
    display: grid;
    margin-top: clamp(5rem, 12vw, 10rem);
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--accent);
    color: #171713;
  }

  .editorial__image-wrap {
    min-height: 23rem;
  }

  .editorial__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial__content {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .editorial h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(2.7rem, 6.5vw, 5rem);
  }

  .editorial__content > p {
    max-width: 31rem;
    margin: 1.4rem 0 2rem;
    color: rgb(23 23 19 / 72%);
  }

  .category-grid {
    display: grid;
    gap: 0.85rem;
  }

  .category-tile {
    position: relative;
    min-height: 19rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-muted);
  }

  .category-tile::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgb(12 12 10 / 72%) 100%);
    content: "";
  }

  .category-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .category-tile span {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.2rem;
    left: 1.25rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    color: #fffef9;
  }

  .category-tile small {
    color: rgb(255 254 249 / 72%);
    font-size: 0.68rem;
  }

  .category-tile strong {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .closing-cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-block: 1px solid var(--border);
  }

  .closing-cta h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
  }

  .closing-cta p {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @media (hover: hover) {
    .category-tile:hover img {
      transform: scale(1.035);
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      display: flex;
      flex-direction: column;
    }

    .hero__media {
      order: 1;
      height: clamp(20rem, 67vw, 31rem);
      min-height: 0;
    }

    .hero__image {
      object-position: 65% center;
    }

    .hero__content {
      order: 2;
      min-height: 29rem;
      padding: clamp(1.5rem, 6vw, 3rem);
    }

    .hero h1 {
      font-size: clamp(3.2rem, 13vw, 5.2rem);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
    }

    .editorial {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .category-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: 12rem;
    }

    .category-tile {
      min-height: 0;
    }

    .category-tile--1,
    .category-tile--4 {
      grid-column: span 2;
    }

    .category-tile--2,
    .category-tile--3 {
      grid-column: span 4;
    }

    .category-tile--3 {
      grid-row: span 2;
    }

    .category-tile--4 {
      grid-row: span 3;
    }

    .category-tile--5 {
      grid-column: span 4;
    }
  }

  @media (max-width: 40rem) {
    .section-heading {
      display: block;
    }

    .section-heading__link {
      margin-top: 1.1rem;
    }

    .hero__actions,
    .closing-cta {
      align-items: flex-start;
      flex-direction: column;
    }

    .closing-cta .button-secondary {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-ribbon a,
    .category-tile img {
      transition: none;
    }
  }
</style>
