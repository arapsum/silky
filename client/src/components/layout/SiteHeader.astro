---
import { MagnifyingGlassIcon } from "@phosphor-icons/react";
import { CartIndicator } from "@/components/cart/CartIndicator";
import { ThemeToggle } from "@/components/theme/ThemeToggle";
import { CART_COUNT_COOKIE } from "@/stores/cart";
import { MobileNavigation } from "./MobileNavigation";

const cookieCount = Number.parseInt(Astro.cookies.get(CART_COUNT_COOKIE)?.value ?? "0", 10);
const initialCartCount = Number.isFinite(cookieCount) ? Math.max(0, cookieCount) : 0;
---

<header class="site-header">
  <div class="site-header__main shell">
    <a class="brand" href="/" aria-label="Silk home">
      <span>Silk</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      <a href="/shop">Collection</a>
      <a href="/shop">Shop</a>
      <a href="/">House</a>
    </nav>

    <form action="/shop" class="site-header__search" method="get" role="search">
      <MagnifyingGlassIcon aria-hidden="true" size={18} weight="regular" />
      <label class="sr-only" for="catalogue-search">Search the catalogue</label>
      <input
        id="catalogue-search"
        name="search"
        placeholder="Search"
        type="search"
      />
    </form>

    <div class="site-header__actions">
      <a class="account-action" href="/account" aria-label="Your account">
        <span>Account</span>
      </a>
      <CartIndicator initialCount={initialCartCount} client:load />
      <ThemeToggle compact client:load />
    </div>
    <MobileNavigation client:load />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .site-header__main {
    display: grid;
    min-height: 5.4rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .site-header__nav,
  .site-header__search {
    display: none;
  }

  :global(astro-island:has(.mobile-navigation)) {
    position: relative;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.85rem;
  }

  :global(.site-header__actions .theme-toggle) {
    display: none;
  }

  :global(.cart-indicator) {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    gap: 0.3rem;
    border: 0;
    border-radius: 0;
    color: var(--text);
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  :global(.cart-indicator svg) {
    display: none;
  }

  :global(.cart-indicator:hover),
  .account-action:hover {
    color: var(--text-muted);
  }

  .account-action {
    display: none;
    min-height: 2.7rem;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0;
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  :global(.mobile-navigation__trigger) {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--text);
  }

  :global(.mobile-navigation__panel) {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(24rem, calc(100vw - 2rem));
    padding: 0.8rem 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    box-shadow: 0 1.25rem 3rem rgb(20 20 16 / 8%);
  }

  :global(.mobile-navigation__panel nav) {
    display: grid;
  }

  :global(.mobile-navigation__panel nav a) {
    display: flex;
    min-height: 3rem;
    align-items: center;
    padding: 0.85rem 0.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.7rem;
    font-weight: 680;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  :global(.mobile-navigation__panel nav a:last-child) {
    border-bottom: 0;
  }

  :global(.mobile-navigation__search) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.75rem 0.1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  :global(.mobile-navigation__search input) {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.mobile-navigation__theme) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    padding: 0.85rem 0.75rem 0.2rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 720;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 64rem) {
    .site-header__main {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      gap: clamp(1rem, 2.2vw, 2rem);
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      justify-self: center;
      gap: clamp(1.6rem, 3vw, 3.25rem);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .site-header__nav a {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      min-height: 2.7rem;
      transition: color 150ms ease;
    }

    .site-header__nav a:hover {
      color: var(--text-muted);
    }

    .site-header__search {
      display: flex;
      min-height: 2.7rem;
      align-items: center;
      gap: 0.65rem;
      justify-self: end;
      width: 5.5rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
      transition: color 180ms ease, border-color 180ms ease;
    }

    .site-header__search:focus-within {
      width: min(100%, 14rem);
    }

    .site-header__search input {
      min-width: 0;
      flex: 1;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .site-header__search input::placeholder {
      color: var(--text);
      opacity: 1;
    }

    .site-header__actions {
      gap: clamp(1rem, 1.8vw, 1.85rem);
    }

    :global(.site-header__actions .theme-toggle--compact) {
      width: 1.8rem;
      height: 2.7rem;
      border-bottom: 1px solid var(--border);
    }

    :global(astro-island:has(.mobile-navigation)) {
      display: none;
    }

    :global(.site-header__actions .theme-toggle) {
      display: inline-flex;
    }

    .account-action {
      display: inline-flex;
    }
  }
</style>
