---
import { CheckoutStatus } from "@/components/checkout/CheckoutStatus";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
const orderPid = Astro.url.searchParams.get("order_pid") ?? "";
---
<BaseLayout title="Payment confirmation | Silk" description="Confirming your Silk order payment." noIndex>
  <SiteHeader /><main class="shell"><CheckoutStatus client:load mode="success" orderPid={orderPid} /></main>
</BaseLayout>
