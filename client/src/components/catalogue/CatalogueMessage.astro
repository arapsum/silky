---
interface Props {
  title: string;
  message: string;
}

const { title, message } = Astro.props;
---

<section class="catalogue-message" role="status">
  <p class="eyebrow">Catalogue note</p>
  <h2>{title}</h2>
  <p>{message}</p>
</section>

<style>
  .catalogue-message {
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface-raised);
    text-align: center;
  }

  .catalogue-message .eyebrow {
    margin: 0;
    color: var(--text-muted);
  }

  .catalogue-message h2 {
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .catalogue-message > p:last-child {
    max-width: 34rem;
    margin: 0.75rem auto 0;
    color: var(--text-muted);
  }
</style>
