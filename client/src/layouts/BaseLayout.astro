---
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/manrope";
import "@/styles/global.css";
import { ToastViewport } from "@/components/feedback/ToastViewport";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = "Silk | Considered clothing for everyday life",
  description = "Shop the Silk collection of refined everyday clothing, footwear, and accessories.",
  image = "/images/silk-editorial-hero.webp",
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem("silk-theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch {
        // A blocked storage context can still use the system theme.
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: Silk is an open house catalogue, not a generic storefront grid.
      OWN-WORLD: Ivory paper, near-black ink, hairline rules, serif-led display type, and quiet utility lettering.
      STORY: Visitors understand the edit, browse its categories, and move into real API-backed pieces.
      FIRST VIEWPORT: The shared house header leads into a constrained editorial hero; supplied campaign art is used as photography, followed by real category and product content.
      FORM: House catalogue / editorial register; direction seed 9b6fab96.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <slot />
    <ToastViewport client:load />
  </body>
</html>
