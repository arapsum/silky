---
import AuthHeader from "@/components/layout/AuthHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<BaseLayout title={`${title} | Silk`} description={description} noIndex>
  <div class="auth-shell">
    <AuthHeader />
    <main class="auth-page shell">
      <div class="auth-page__visual" aria-hidden="true">
        <img alt="" decoding="async" height="810" loading="eager" src="/images/silk-editorial-hero.webp" width="1439" />
        <p>Considered pieces.<br />Kept close.</p>
      </div>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .auth-shell {
    display: grid;
    min-height: 100dvh;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .auth-page {
    display: grid;
    box-sizing: border-box;
    min-height: 0;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(1.25rem, 3vh, 2.25rem);
  }

  .auth-page__visual {
    position: relative;
    display: none;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--surface-muted);
  }

  .auth-page__visual::after {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgb(15 15 12 / 80%));
    content: "";
  }

  .auth-page__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .auth-page__visual p {
    position: absolute;
    z-index: 1;
    right: 2.5rem;
    bottom: 2rem;
    left: 2.5rem;
    margin: 0;
    color: white;
    font-family: var(--font-display);
    font-size: var(--text-headline);
    font-weight: 760;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  @media (min-width: 58rem) {
    .auth-shell {
      height: 100dvh;
      overflow: hidden;
    }

    .auth-page {
      align-self: stretch;
      grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.72fr);
      overflow: hidden;
    }

    .auth-page__visual {
      display: block;
      align-self: stretch;
      max-height: 48rem;
    }
  }

  @media (min-width: 58rem) and (max-height: 46rem) {
    .auth-page {
      padding-block: 0.9rem;
    }

    .auth-page :global(.auth-card > .eyebrow) {
      margin-bottom: 0.45rem;
    }

    .auth-page :global(.auth-card h1) {
      font-size: var(--text-headline);
    }

    .auth-page :global(.auth-card form) {
      gap: 0.65rem;
      margin-top: 1.2rem;
    }

    .auth-page :global(.form-field) {
      gap: 0.25rem;
    }

    .auth-page :global(.form-field input) {
      min-height: 2.65rem;
      padding-block: 0.55rem;
    }

    .auth-page :global(.auth-card__alternate) {
      margin-top: 0.75rem;
    }
  }
</style>
